# Host directory containing persistent Kanleaf deployment data.
KANLEAF_DATA_DIR=/srv/kanleaf

# Use 0.0.0.0 for direct LAN/VPN access. Keep 127.0.0.1 behind a local proxy.
KANLEAF_BIND_ADDRESS=127.0.0.1
KANLEAF_PORT=3000

POSTGRES_DB=kanleaf
POSTGRES_USER=kanleaf
# Use a strong URL-safe password because Compose builds DATABASE_URL from it.
POSTGRES_PASSWORD=change-me
